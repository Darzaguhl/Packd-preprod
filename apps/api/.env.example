# ── Database ──────────────────────────────────────────────────────────────────
# Supabase pooled connection (pgBouncer) — used by Prisma for all queries
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct (non-pooled) connection — used by Prisma for migrations only
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# pg-boss job queue — MUST be a direct (non-pooled) connection.
# pg-boss uses advisory locks and LISTEN/NOTIFY which break with
# PgBouncer in transaction-pooling mode. Use the same value as DIRECT_URL.
PGBOSS_DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── Supabase Auth ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://[ref].supabase.co

# Service role key — grants admin access to Supabase Auth. Keep secret, never expose.
# Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use sk_test_... for development/staging, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — Stripe Dashboard → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# From address for transactional emails. Must be a verified sender in Resend.
EMAIL_FROM=noreply@yourstudio.com

# ── iCal feed ─────────────────────────────────────────────────────────────────
# HMAC secret for signing member/instructor iCal feed URLs.
# Generate with: openssl rand -hex 32
# REQUIRED in production — if unset, feed tokens are trivially forgeable.
ICAL_SECRET=change-me-in-production

# Previous iCal secret — set ONLY during key rotation (see docs/secret-rotation.md).
# Tokens signed with this key are still accepted for ~30 days while calendar apps
# re-fetch their subscriptions. Leave unset in normal operation.
# ICAL_SECRET_PREVIOUS=

# ── Staff invite ───────────────────────────────────────────────────────────────
# HMAC secret for signing staff invite tokens (7-day expiry).
# Falls back to ICAL_SECRET if not set. Generate with: openssl rand -hex 32
INVITE_SECRET=change-me-in-production

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# Comma-separated list of allowed CORS origins (no trailing slash)
CORS_ORIGIN=http://localhost:3000

# Public URL of the web app — used in Stripe checkout redirects and outgoing emails
WEB_URL=http://localhost:3000

# ── Error tracking ────────────────────────────────────────────────────────────
# Sentry DSN — leave blank to disable. Get from sentry.io → Project → Settings → DSN
SENTRY_DSN=

# ── Logging ───────────────────────────────────────────────────────────────────
# pino log level: trace | debug | info | warn | error | fatal  (default: info)
LOG_LEVEL=info

# Fallback alert email when a studio has no supportEmail configured
OPS_EMAIL=
