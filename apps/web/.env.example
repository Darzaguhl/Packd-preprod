# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co

# Publishable (anon) key — safe to expose in the browser.
# Must be the sb_publishable_... format (not the legacy anon key).
# Project Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ── API ───────────────────────────────────────────────────────────────────────
# URL of the Packd API server
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Studio ────────────────────────────────────────────────────────────────────
# The default studio ID shown to members when no studio is specified in the URL.
# Get this from the DB: SELECT id FROM "Studio" LIMIT 1;
NEXT_PUBLIC_STUDIO_ID=your-studio-cuid
