generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Studio (tenant) ────────────────────────────────────────────────────────

model Studio {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  primaryColor String  @default("#000000")
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  timeFormat  String   @default("24h")
  websiteUrl  String?
  supportEmail String?
  // Booking window settings
  bookingWindowDays   Int  @default(30)  // how far in advance members can book
  bookingCloseHours   Int  @default(1)   // booking closes N hours before class
  // Feature toggles
  waitlistEnabled          Boolean @default(true)
  guestCheckInEnabled      Boolean @default(true)
  creditPurchaseEnabled    Boolean @default(true)
  selfCheckInEnabled       Boolean @default(false)
  // Class reminder (null = disabled)
  classReminderHours       Int?    @default(24)
  // Membership pause rules
  maxPauseDays             Int     @default(30)
  maxPausesPerYear         Int     @default(2)
  allowMemberPause         Boolean @default(false) // whether members can self-pause
  // Tax
  taxRatePct               Float   @default(0)     // e.g. 6.0 = 6% VAT; 0 = no tax
  stripeTaxRateId          String?                  // cached Stripe TaxRate ID
  // Referral
  referralRewardCredits    Int     @default(0)      // credits given to referrer per signup; 0 = disabled
  // Reporting
  weeklyDigestEnabled      Boolean @default(false) // send Monday digest email to studio_admins
  // AI assistant
  aiEnabled                Boolean @default(true)
  anthropicApiKey          String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locations     Location[]
  instructors   Instructor[]
  members       Member[]
  classTemplates ClassTemplate[]
  classSessions  ClassSession[]
  classSchedules ClassSchedule[]
  memberships    MembershipPlan[]
  products       Product[]
  referrals      Referral[]
  cancellationPolicy CancellationPolicy?
  integration   StudioIntegration?
  availabilityBlocks InstructorAvailabilityBlock[]
  staffShifts        StaffShift[]
  staffShiftPatterns StaffShiftPattern[]
  promoCodes    PromoCode[]
  networkMemberships   StudioNetworkMembership[]
  brandMemberships     BrandStudio[]
  franchiseMemberships FranchiseStudio[]
  productSales         ProductSale[]
  waivers              Waiver[]
}

// ─── Brand (top-level hierarchy above franchise) ────────────────────────────

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studios    BrandStudio[]
  franchises Franchise[]
}

model BrandStudio {
  id       String   @id @default(cuid())
  brandId  String
  studioId String
  joinedAt DateTime @default(now())

  brand  Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([brandId, studioId])
  @@index([brandId])
  @@index([studioId])
}

// ─── Franchise (sits between Brand and Studios) ──────────────────────────────

model Franchise {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  brandId     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand   Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  studios FranchiseStudio[]

  @@index([brandId])
}

model FranchiseStudio {
  id          String   @id @default(cuid())
  franchiseId String
  studioId    String
  joinedAt    DateTime @default(now())

  franchise Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([franchiseId, studioId])
  @@index([franchiseId])
  @@index([studioId])
}

// ─── Studio Networks (multi-location booking) ────────────────────────────────

model StudioNetwork {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  studios StudioNetworkMembership[]
}

model StudioNetworkMembership {
  id        String   @id @default(cuid())
  networkId String
  studioId  String
  joinedAt  DateTime @default(now())

  network StudioNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  studio  Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([networkId, studioId])
  @@index([studioId])
}

// ─── External integrations ────────────────────────────────────────────────────

model StudioIntegration {
  id            String    @id @default(cuid())
  studioId      String    @unique
  provider      String    // "mariana_tek"
  // API key stored encrypted at application level — never log or expose raw
  apiKeyEnc     String
  webhookSecret String?
  syncEnabled   Boolean   @default(false)
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
}

// ─── Auth & Users ────────────────────────────────────────────────────────────

model User {
  id        String   @id // matches Supabase Auth user id
  email     String   @unique
  firstName String
  lastName  String
  avatarUrl String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member      Member?
  instructors Instructor[]
  memberNotes MemberNote[] @relation("MemberNoteStaff")
}

// ─── Location & Rooms ────────────────────────────────────────────────────────

model Location {
  id        String  @id @default(cuid())
  studioId  String
  name      String
  address   String
  city      String
  country   String
  timezone  String

  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  rooms    Room[]
}

model Room {
  id         String  @id @default(cuid())
  locationId String
  name       String
  capacity   Int

  location      Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  classSessions ClassSession[]
  layouts       RoomLayout[]
  schedules     ClassSchedule[]
}

model RoomLayout {
  id        String   @id @default(cuid())
  roomId    String
  name      String   @default("Default")
  widthM    Float    @default(10)
  lengthM   Float    @default(15)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room     Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  stations Station[]
  sessions ClassSession[]
}

enum StationType {
  BIKE
  TREADMILL
  BENCH
  ROWER
  MAT
  REFORMER
  BARRE
  OTHER
}

model Station {
  id       String      @id @default(cuid())
  layoutId String
  type     StationType
  label    String
  xM       Float
  yM       Float
  rotation Int         @default(0)

  layout   RoomLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

// ─── Instructors ─────────────────────────────────────────────────────────────

model Instructor {
  id                 String  @id @default(cuid())
  userId             String
  studioId           String
  bio                String?
  photoUrl           String?
  permissions        Json    @default("{}")
  externalId         String? // e.g. Mariana Tek instructor ID
  payRatePerHeadCents Int?   // cents paid per confirmed checked-in attendee

  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studio             Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  classSessions      ClassSession[]
  schedules          ClassSchedule[]
  substituteFor      ClassSession[] @relation("SubstituteInstructor")
  photos             InstructorPhoto[]
  availabilityBlocks InstructorAvailabilityBlock[]

  @@unique([userId, studioId])
}

// ─── Instructor Photos ────────────────────────────────────────────────────────

model InstructorPhoto {
  id                String   @id @default(cuid())
  instructorId      String
  studioId          String
  storageKey        String   // path within the Supabase Storage bucket
  url               String   // full public URL
  fileName          String
  approvedForSocial Boolean  @default(false)
  uploadedBy        String   // userId of uploader (instructor or manager)
  createdAt         DateTime @default(now())

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId])
  @@index([studioId])
}

// ─── Class Templates & Sessions ──────────────────────────────────────────────

model ClassTemplate {
  id          String   @id @default(cuid())
  studioId    String
  name        String
  description String?
  durationMin Int
  sport       SportType
  color       String   @default("#6366f1")
  imageUrl    String?

  isPrivate   Boolean  @default(false)  // private templates generate private sessions by default

  // Optional schedule defaults — pre-fill values when creating a schedule
  defaultInstructorId    String?
  defaultRoomId          String?
  defaultCapacity        Int?
  defaultCreditsRequired Int?
  defaultStartTime       String?   // "HH:MM"
  defaultStartTime2      String?   // optional second daily slot
  defaultDaysOfWeek      Int[]     @default([])
  defaultIntervalWeeks   Int       @default(1)

  studio        Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  classSessions ClassSession[]
  schedules     ClassSchedule[]
}

enum SportType {
  CYCLING
  HIIT
  YOGA
  PILATES
  BARRE
  ROWING
  RUNNING
  STRENGTH
  OTHER
}

model ClassSchedule {
  id              String    @id @default(cuid())
  studioId        String
  templateId      String
  instructorId    String
  roomId          String
  capacity        Int
  creditsRequired Int       @default(1)
  daysOfWeek      Int[]     // 0=Sun … 6=Sat
  startTime       String    // "HH:MM" 24h in studio timezone
  durationMin     Int
  intervalWeeks   Int       @default(1) // 1=every week, 2=every 2nd week, etc.
  validFrom       DateTime
  validUntil      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  studio     Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  template   ClassTemplate @relation(fields: [templateId], references: [id])
  instructor Instructor    @relation(fields: [instructorId], references: [id])
  room       Room          @relation(fields: [roomId], references: [id])
  sessions   ClassSession[]

  @@index([studioId])
}

model ClassSession {
  id                     String        @id @default(cuid())
  studioId               String
  templateId             String
  instructorId           String
  roomId                 String
  layoutId               String?
  scheduleId             String?
  substituteInstructorId String?
  startsAt               DateTime
  endsAt                 DateTime
  capacity               Int
  status                 SessionStatus @default(SCHEDULED)
  creditsRequired        Int           @default(1)
  isPrivate              Boolean       @default(false)
  externalId             String?       // e.g. Mariana Tek class occurrence ID
  source                 String        @default("packd") // "packd" | "mariana_tek"
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  studio       Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  template     ClassTemplate  @relation(fields: [templateId], references: [id])
  instructor   Instructor     @relation(fields: [instructorId], references: [id])
  room         Room           @relation(fields: [roomId], references: [id])
  layout       RoomLayout?    @relation(fields: [layoutId], references: [id])
  schedule     ClassSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  substitute   Instructor?    @relation("SubstituteInstructor", fields: [substituteInstructorId], references: [id])
  bookings     Booking[]
  waitlist     WaitlistEntry[]

  @@index([studioId, startsAt])
  @@index([scheduleId])
  @@unique([studioId, externalId])
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── Members ─────────────────────────────────────────────────────────────────

model Member {
  id         String   @id @default(cuid())
  userId     String   @unique
  studioId   String
  joinedAt   DateTime @default(now())
  notes      String?
  externalId String?  // e.g. Mariana Tek member ID (scoped per studio)
  source     String   @default("packd") // "packd" | "mariana_tek"
  staffRoles       String[] @default([])  // [] = regular member; can hold both "fronthost" and "instructor"
  studioIds        String[] @default([])  // all studios this staff member is assigned to (mirrors app_metadata.studioIds)
  staffPermissions Json?                  // fronthost permission overrides (FronthostPermissions)

  // Profile enrichment
  birthday             DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  guestPassBalance     Int      @default(0)

  // Pay
  payRateHourlyCents   Int?     // hourly rate for shift-based staff (fronthosts)

  // Stripe
  stripeCustomerId     String?

  // Member preferences & lifecycle
  emailPreferences     Json     @default("{}")   // { classReminder: true, marketing: true, waitlist: true }
  lastWinbackAt        DateTime?                  // last win-back email sent
  creditWarningSentAt  DateTime?                  // last credit expiry warning email sent
  referralCode         String?  @unique           // unique code to share

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  studio          Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  creditBalance   CreditBalance?
  memberships     MembershipSubscription[]
  transactions    CreditTransaction[]
  memberNotes     MemberNote[]
  promoRedemptions PromoCodeRedemption[]
  guestPasses     GuestPass[]
  productSales    ProductSale[]
  staffShifts        StaffShift[]
  staffShiftPatterns StaffShiftPattern[]
  referralsSent      Referral[] @relation("ReferrerReferrals")
  referralsReceived  Referral[] @relation("RefereeReferrals")
  waiverSignatures   WaiverSignature[]

  @@unique([studioId, externalId])
  @@index([studioId])              // member list / export queries
  @@index([staffRoles], type: Gin)
  @@index([studioIds], type: Gin)
}

// ─── Bookings ─────────────────────────────────────────────────────────────────

model Booking {
  id          String        @id @default(cuid())
  sessionId   String
  memberId    String
  stationId   String?
  status      BookingStatus @default(CONFIRMED)
  bookedAt    DateTime      @default(now())
  checkedIn   Boolean       @default(false)
  checkedInAt DateTime?
  memberNote  String?                          // optional note from member at booking time
  externalId  String?       @unique // Mariana Tek reservation ID (globally unique)
  source      String        @default("packd")

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  station Station?     @relation(fields: [stationId], references: [id])

  @@unique([sessionId, memberId])
  @@unique([sessionId, stationId])
  @@index([memberId])
  @@index([sessionId, status])
  @@index([bookedAt])              // stats query: bookedAt >= today AND status = CONFIRMED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  LATE_CANCELLED
  NO_SHOW
}

// ─── Waitlist ─────────────────────────────────────────────────────────────────

model WaitlistEntry {
  id        String              @id @default(cuid())
  sessionId String
  memberId  String
  position  Int
  status    WaitlistEntryStatus @default(WAITING)
  joinedAt  DateTime            @default(now())
  notifiedAt DateTime?
  expiresAt  DateTime?

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId])
  @@index([sessionId, position])
}

enum WaitlistEntryStatus {
  WAITING
  NOTIFIED
  CONFIRMED
  EXPIRED
  REMOVED
}

// ─── Credits & Memberships ────────────────────────────────────────────────────

model CreditBalance {
  id        String @id @default(cuid())
  memberId  String @unique
  balance   Int    @default(0)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id        String          @id @default(cuid())
  memberId  String
  amount    Int             // positive = credit, negative = debit
  type      TransactionType
  note      String?
  expiresAt DateTime?       // set when credits come from a plan with creditExpiryDays
  createdAt DateTime        @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([expiresAt])             // nightly credit expiry sweep
  @@index([createdAt])             // analytics window queries
}

enum TransactionType {
  PURCHASE
  CLASS_DEBIT
  REFUND
  LATE_CANCEL_FEE
  NO_SHOW_FEE
  MANUAL_ADJUSTMENT
  MEMBERSHIP_RENEWAL
  EXPIRY
  EXPIRY_PROCESSED  // marks source PURCHASE rows consumed by the expiry sweep — prevents double-counting
  REFERRAL          // credits granted to referrer when referee completes first booking
}

model MembershipPlan {
  id             String  @id @default(cuid())
  studioId       String
  name           String
  description    String?
  priceInCents   Int
  intervalMonths Int     @default(1)
  creditsPerCycle     Int?   // null = unlimited
  guestPassesPerCycle Int   @default(0)
  creditExpiryDays    Int?   // credits granted expire N days after grant; null = never expire
  isIntroOffer        Boolean @default(false) // can only be redeemed once per member
  maxRedemptionsPerMember Int @default(1)     // how many times a member can subscribe to this plan
  stripeProductId String?
  stripePriceId   String?

  studio        Studio                   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  subscriptions MembershipSubscription[]
}

model MembershipSubscription {
  id          String             @id @default(cuid())
  memberId    String
  planId      String
  status      SubscriptionStatus @default(ACTIVE)
  pausedUntil DateTime?          // set when status = PAUSED; null = indefinite pause
  startDate   DateTime
  endDate     DateTime?
  stripeSubId String?
  externalId  String?            @unique // Mariana Tek contract/agreement ID
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  member Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan   MembershipPlan @relation(fields: [planId], references: [id])

  @@index([memberId])
  @@index([status])                // analytics subscription count by status
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  PAST_DUE
}

// ─── Cancellation Policy ─────────────────────────────────────────────────────

model CancellationPolicy {
  id                   String @id @default(cuid())
  studioId             String @unique
  lateCancelWindowHours Int   @default(12)
  lateCancelFeeCredits  Int   @default(1)
  noShowFeeCredits      Int   @default(1)
  waitlistWindowMinutes Int   @default(15)

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
}

// ─── Products (retail) ───────────────────────────────────────────────────────

model Product {
  id               String  @id @default(cuid())
  studioId         String
  name             String
  category         String  @default("Other")   // e.g. "Drinks", "Food", "Merchandise"
  priceInCents     Int
  creditsRequired  Int     @default(0)
  imageUrl         String?
  inStock          Boolean @default(true)
  stripeProductId  String?
  stripePriceId    String?

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
}

// ─── Product sales log ────────────────────────────────────────────────────────

model ProductSale {
  id            String   @id @default(cuid())
  memberId      String
  studioId      String
  items         Json     // [{ productId, name, qty, priceInCents, creditsRequired }]
  totalCents    Int      @default(0)
  totalCredits  Int      @default(0)
  paymentMethod String   // 'card' | 'cash' | 'credits' | 'free'
  stripePaymentIntentId String?
  staffUserId   String?
  soldAt        DateTime @default(now())
  refundedAt    DateTime?
  refundedCents Int?
  stripeRefundId   String?
  stripeReceiptUrl String?    // Stripe receipt URL captured from webhook
  failedAt         DateTime?

  member  Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  studio  Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([studioId, soldAt])
}

// ─── Stripe webhook deduplication ────────────────────────────────────────────

model StripeEvent {
  id          String   @id  // Stripe event ID (evt_...)
  type        String
  processedAt DateTime @default(now())
}

// ─── Audit log ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String   // Supabase userId of who performed the action
  actorRole String
  action    String   // e.g. 'credit.adjust', 'booking.cancel', 'refund.issue'
  targetId  String?  // ID of the affected resource (memberId, saleId, etc.)
  meta      Json?    // extra context (amount, reason, old/new values)
  studioId  String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([studioId, createdAt])
  @@index([targetId])
}

// ─── Member notes (staff-authored, audited) ───────────────────────────────────

model MemberNote {
  id        String   @id @default(cuid())
  memberId  String
  staffId   String   // userId of staff who added the note
  content   String
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  staff  User   @relation("MemberNoteStaff", fields: [staffId], references: [id])

  @@index([memberId])
}

// ─── Instructor availability blocks ──────────────────────────────────────────

model InstructorAvailabilityBlock {
  id           String     @id @default(cuid())
  instructorId String
  studioId     String
  title        String
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime   @default(now())

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  studio     Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([instructorId, startDate])
  @@index([studioId, startDate])
}

// ─── Promo codes ──────────────────────────────────────────────────────────────

model PromoCode {
  id          String    @id @default(cuid())
  studioId    String
  code        String
  description String?
  // CREDIT_GRANT: add `value` credits · FREE_CLASS: add 1 credit
  // MEMBERSHIP_PCT: `value` = percent off · MEMBERSHIP_FLAT: `value` = cents off
  type        String
  value       Int       @default(0)
  maxUses     Int?      // null = unlimited
  usageCount  Int       @default(0)
  validFrom   DateTime  @default(now())
  validUntil  DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  stripeCouponId String?   // cached Stripe coupon ID for MEMBERSHIP_PCT/FLAT types

  studio      Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  redemptions PromoCodeRedemption[]

  @@unique([studioId, code])
  @@index([studioId, isActive])
}

model PromoCodeRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  memberId    String
  redeemedAt  DateTime  @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, memberId])
  @@index([memberId])
}

// ─── Referrals ───────────────────────────────────────────────────────────────

model Referral {
  id            String   @id @default(cuid())
  studioId      String
  referrerId    String
  refereeId     String
  rewardCredits Int      @default(0)   // credits granted to referrer when rewarded
  rewarded      Boolean  @default(false)
  createdAt     DateTime @default(now())

  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  referrer Member @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  Member @relation("RefereeReferrals", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([referrerId, refereeId])
  @@index([studioId])
  @@index([refereeId])
}

// ─── Staff shifts ─────────────────────────────────────────────────────────────

model StaffShiftPattern {
  id            String    @id @default(cuid())
  memberId      String
  studioId      String
  daysOfWeek    Int[]     // 0=Sun … 6=Sat, same convention as ClassSchedule
  startTime     String    // "HH:MM" 24h
  endTime       String    // "HH:MM" 24h
  intervalWeeks Int       @default(1)  // 1=every week, 2=every other week, etc.
  validFrom     DateTime
  validUntil    DateTime?
  note          String?
  createdAt     DateTime  @default(now())

  member Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  studio Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  shifts StaffShift[]

  @@index([studioId, memberId])
  @@index([memberId])
}

model StaffShift {
  id        String   @id @default(cuid())
  memberId  String
  studioId  String
  startsAt  DateTime
  endsAt    DateTime
  note      String?
  patternId String?  // set when generated from a StaffShiftPattern
  createdAt DateTime @default(now())

  member  Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  studio  Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  pattern StaffShiftPattern? @relation(fields: [patternId], references: [id], onDelete: SetNull)

  @@index([studioId, startsAt])
  @@index([memberId, startsAt])
  @@index([patternId])
}

// ─── Waivers ─────────────────────────────────────────────────────────────────

model Waiver {
  id        String   @id @default(cuid())
  studioId  String
  title     String
  body      String   @db.Text
  isActive  Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studio     Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  signatures WaiverSignature[]

  @@index([studioId, isActive])
}

model WaiverSignature {
  id        String   @id @default(cuid())
  waiverId  String
  memberId  String
  signedAt  DateTime @default(now())
  ipAddress String?

  waiver Waiver @relation(fields: [waiverId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([waiverId, memberId])
  @@index([memberId])
}

// ─── Guest passes ─────────────────────────────────────────────────────────────

model GuestPass {
  id        String   @id @default(cuid())
  memberId  String
  studioId  String
  guestName String?  // null for grant entries (positive amount)
  sessionId String?  // which session the guest attended
  note      String?
  amount    Int      // positive = granted, negative = used
  createdAt DateTime @default(now())

  member  Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([studioId])
}
