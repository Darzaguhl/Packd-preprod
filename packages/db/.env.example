# Direct (non-pooled) Postgres connection — required for Prisma migrations
# and the shadow database used by `prisma migrate dev`.
# Use the Supabase direct connection URL (port 5432), NOT the pgBouncer pooler.
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Shadow database for `prisma migrate dev` (needs a separate empty DB).
# Can be a second Supabase project or a local Postgres instance.
# Not needed for `prisma migrate deploy` (CI/prod).
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
